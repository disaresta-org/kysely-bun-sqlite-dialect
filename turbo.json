{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local", "biome.json", "tsconfig.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "cache": false
    },
    "lint": {},
    "lint:staged": {
      "cache": false
    },
    "verify-types": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
